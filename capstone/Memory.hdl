
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:

    // Decode memory load signal
    DMux4Way(
        in=load,
        sel=address[13..14],
        a=loadRAM0,
        b=loadRAM1,
        c=loadScreen,
        d=loadKeyboard
    );

    // Combine RAM load signals
    Or(
        a=loadRAM0,
        b=loadRAM1,
        out=loadRAM
    );

    // RAM16K
    RAM16K(
        in=in,
        load=loadRAM,
        address=address[0..13],
        out=ramOut
    );

    // Screen memory
    Screen(
        in=in,
        load=loadScreen,
        address=address[0..12],
        out=screenOut
    );

    // Keyboard
    Keyboard(
        out=keyboardOut
    );

    // Select output
    Mux4Way16(
        a=ramOut,
        b=ramOut,
        c=screenOut,
        d=keyboardOut,
        sel=address[13..14],
        out=out
    );
}
